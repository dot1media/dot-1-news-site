# Shared Neon database — use the SAME pooled connection string as the Dot 1 News app.
# Neon dashboard -> Connect -> "Pooled connection". This is what keeps the site
# and the app in sync: both read and write the same tables, one source of truth.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# The site's own public URL, for canonical tags and OG metadata.
PUBLIC_WEB_URL=https://news.dot1.media

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). When set, GA4 loads
# site-wide and the Reader Revenue Manager can read survey/subscription events.
# Find it in Google Analytics -> Admin -> Data Streams -> your web stream.
NEXT_PUBLIC_GA_ID=
